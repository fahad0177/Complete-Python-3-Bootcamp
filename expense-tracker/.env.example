# Copy this file to .env and fill in your real values.
# (When deploying to Render, set these in the dashboard instead - no .env needed.)

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# From Smartsheet -> profile picture -> Personal Settings -> API Access -> Generate new access token
SMARTSHEET_ACCESS_TOKEN=...

# Any password you like. Whoever knows it can use your app, so pick a decent one.
APP_PASSWORD=...

# --- Optional ---
# The app finds (or creates) a sheet named "Business Expenses" automatically.
# Uncomment to use a different name or a specific existing sheet instead.
# SHEET_NAME=Business Expenses
# SMARTSHEET_SHEET_ID=...
