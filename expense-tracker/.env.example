# Copy this file to .env and fill in your real values.

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# From Smartsheet -> Account -> Personal Settings -> API Access -> Generate new access token
SMARTSHEET_ACCESS_TOKEN=...

# Run `python setup_sheet.py` once to create the sheet and print this ID,
# or copy the ID of an existing sheet (File -> Properties -> Sheet ID).
SMARTSHEET_SHEET_ID=...
