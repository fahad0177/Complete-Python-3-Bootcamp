# Copy this file to .env and fill in your real values.
# (When deploying to Render, set these in the dashboard instead - no .env needed.)

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Storage: your own Google Drive via OAuth (free, recommended) ---
# From console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application, with redirect URI
#   https://<your-app>.onrender.com/google/callback
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# Leave this empty at first. Open the app, tap "Connect Google Drive", approve,
# and paste the connection key the app shows you here (or in Render's env vars).
GOOGLE_REFRESH_TOKEN=

# --- Storage alternative: Smartsheet (needs a plan with API access) ---
# SMARTSHEET_ACCESS_TOKEN=...

# --- Storage alternative: Google service account (Google Workspace only) ---
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# GOOGLE_SHEET_ID=...
# GOOGLE_FOLDER_ID=...

# Any password you like. Whoever knows it can use your app, so pick a decent one.
APP_PASSWORD=...

# --- Optional ---
# SHEET_NAME=Business Expenses
# FOLDER_NAME=Business Expense Receipts
