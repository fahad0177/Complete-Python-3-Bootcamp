# Copy this file to .env and fill in your real values.
# (When deploying to Render, set these in the dashboard instead - no .env needed.)

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Storage: Google Sheets + Drive (free, recommended) ---
# Paste the ENTIRE contents of the service account JSON key file you downloaded
# from console.cloud.google.com (IAM & Admin -> Service Accounts -> Keys).
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Your own Gmail address - the sheet and receipts folder get shared with it.
SHARE_WITH_EMAIL=you@gmail.com

# --- Storage alternative: Smartsheet (needs a plan with API access) ---
# Leave GOOGLE_SERVICE_ACCOUNT_JSON empty and set this instead.
# SMARTSHEET_ACCESS_TOKEN=...

# Any password you like. Whoever knows it can use your app, so pick a decent one.
APP_PASSWORD=...

# --- Optional ---
# SHEET_NAME=Business Expenses
# FOLDER_NAME=Business Expense Receipts
# SMARTSHEET_SHEET_ID=...
